{
  "name": "shortcuts-font",
  "repository": "github:fabiospampinato/shortcuts-font",
  "description": "A minimal font designed to beautifully render characters used for representing shortcuts.",
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "clean": "tsex clean",
    "build": "npm run build:ttf && npm run build:woff2",
    "build:ttf": "ifont build -i resources/icons/**/*.svg -o resources/fonts/ShortcutsFont.ttf",
    "build:woff2": "woff2_compress resources/fonts/ShortcutsFont.ttf",
    "demo": "open resources/demo/index.html",
    "preview": "ifont preview -i resources/icons/**/*.svg",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "shortcuts",
    "font"
  ],
  "devDependencies": {
    "ifont": "^2.0.0",
    "tsex": "^4.0.2"
  }
}
